# Salin ke .env dan isi. Jangan commit .env.
ENV=development

# Aplikasi memakai peran pop_app, BUKAN superuser: RLS diabaikan oleh superuser.
DATABASE_URL=postgresql+asyncpg://pop_app:change-me@localhost:5432/pop
# DSN superuser hanya untuk migrasi dan seed.
ADMIN_DATABASE_URL=postgresql://pop:pop@localhost:5432/pop
TEST_DATABASE_URL_APP=postgresql+asyncpg://pop_app:change-me@localhost:5432/pop_test

REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200

JWT_SECRET=ganti-dengan-nilai-acak-32-byte

# echo = provider offline deterministik untuk dev dan tes
LLM_PROVIDER=echo
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

NEXT_PUBLIC_API_URL=http://localhost:8000/v1
